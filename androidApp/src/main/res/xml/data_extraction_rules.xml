<?xml version="1.0" encoding="utf-8"?>
<!--
    No cloud backup (docs/TZ.md, privacy). Device-to-device transfer keeps working so the
    data follows the user to a new phone. Own backup/restore comes with FR-8.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
</data-extraction-rules>
